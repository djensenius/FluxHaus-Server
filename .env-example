# Server Configuration
PORT=8888

# Authentication
BASIC_AUTH_PASSWORD=  # Legacy admin fallback during OIDC transition
RHIZOME_PASSWORD=
DEMO_PASSWORD=

# OIDC (Authentik)
OIDC_ISSUER_URL=https://auth.example.com/application/o/fluxhaus/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://haus.fluxhaus.io/auth/callback
OIDC_ADDITIONAL_ISSUERS=  # Comma-separated additional OIDC issuer URLs (e.g. mobile app providers on same Authentik)

# Session
SESSION_SECRET=change-me-to-a-random-string

# PostgreSQL
POSTGRES_URL=postgresql://fluxhaus:password@localhost:5432/fluxhaus

# InfluxDB
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=fluxhaus
INFLUXDB_BUCKET=fluxhaus

# CORS
CORS_ORIGINS=http://localhost:8080,https://haus.fluxhaus.io
# Browser origins allowed to call the MCP HTTP endpoint. Non-browser MCP clients
# usually omit Origin and are authorized with Bearer tokens.
MCP_ALLOWED_ORIGINS=http://localhost:8080,https://haus.fluxhaus.io,https://claude.ai,https://github.com,https://github.dev,https://vscode.dev
# OAuth redirect origins accepted during MCP dynamic client registration.
# Add trusted remote MCP clients here; localhost defaults are useful for local clients.
MCP_ALLOWED_REDIRECT_ORIGINS=http://localhost,http://127.0.0.1,http://[::1],https://claude.ai,https://github.com,https://github.dev,https://vscode.dev
# Remote MCP authentication: proxy (default, retains existing clients) or oidc.
# Direct mode uses a DEDICATED Authentik application/provider, not the browser,
# mobile or SynthBook issuer. Local proxy OAuth routes are disabled in oidc mode.
MCP_AUTH_MODE=proxy
# Required only in oidc mode; exact issuer including trailing slash and /mcp resource.
# HTTPS required (explicit HTTP loopback is allowed for local development/tests).
# MCP_ISSUER_URL=https://auth.fluxhaus.io/application/o/fluxhaus-mcp-oidc/
# MCP_RESOURCE_URL=https://api.fluxhaus.io/mcp
# Use a separate PUBLIC fluxhaus-mcp-oidc provider; leave the existing
# confidential fluxhaus-mcp provider for the legacy proxy callback unchanged.
# Provider: pre-register a public client, PKCE S256, exact Claude redirect
# https://claude.ai/api/mcp/auth_callback; request offline_access for refresh tokens.
# JWT access tokens must have aud=MCP_RESOURCE_URL and scope fluxhaus:mcp.
# fluxhaus:mcp grants FULL home/tool access including mutations, not read-only.
# Limit grants to accounts already authorized for FluxHaus. See README for
# audience mappings when Authentik lacks RFC 8707 and personal-memory mapping.
# Scoped MCP API keys (Authorization: Bearer fhmcp_<publicId>_<secret>), off by
# default. Scopes: read (explicit read-only allowlist; no state changes,
# influxdb_query, grafana_query_datasource, web/fetch/summarize/view/generate
# tools or camera-url) and full (all tools). Keys only work on /mcp; fhmcp_
# bearers are always rejected on REST routes. Manage via /mcp-keys or
# `node dist/mcp-keys.js`. Set to false to reject all keys immediately.
MCP_API_KEYS_ENABLED=false

# Logging
LOG_LEVEL=info

# Robot Configuration
# Home Assistant Configuration
# To get a token:
# 1. Log in to Home Assistant
# 2. Click your profile (bottom left)
# 3. Scroll to "Long-Lived Access Tokens"
# 4. Create a new token
HOMEASSISTANT_URL=http://homeassistant.local:8123
HOMEASSISTANT_TOKEN=
CLEANBOT_ENTITY_ID=vacuum.v70_ultra_complete
CLEANBOT_BATTERY_ENTITY_ID=sensor.v70_ultra_complete_battery_level
# Indoor climate: Home Assistant integration whose temperature sensors, occupancy
# sensors and thermostat are shown in the app (auto-discovered).
# Matches a config-entry title first, then a domain (homekit_controller = all HomeKit sensors).
INDOOR_CLIMATE_INTEGRATION=ecobee

# Car Configuration (via Home Assistant Kia integration)
# Entity prefix is the name of your vehicle in Home Assistant (e.g., "kia_ev6")
CAR_ENTITY_PREFIX=kia
# Optional cumulative vehicle/charger energy sensor used for measured efficiency.
# The sensor must be monotonic and report Wh or kWh.
CAR_ENERGY_ENTITY_ID=
CAR_ENERGY_UNIT=kWh
# Outdoor temperature series joined to car usage intervals.
CAR_ANALYTICS_OUTDOOR_TEMPERATURE_ENTITY_ID=patio_environment_canada_temperature

# Camera
CAMERA_URL=
CAMERA_ROMPER_URL=
CAMERA_GYM_URL=

# Miele Integration
mieleClientId=
mieleSecretId=
mieleAppliances=

# Bosch / Home Connect Integration
boschClientId=
boschSecretId=
boschAppliance=

# HomeKit Favorites
favouriteHomeKit=

# Home Assistant Scene Favorites
favouriteScenes=

# Modern Dog Integration
MODERN_DOG_URL=
MODERN_DOG_TOKEN=
MODERN_DOG_COOKIE=

# AI_PROVIDER: LLM backend for command processing.
#   Supported: copilot/github-copilot (default), openai, anthropic, zai/z.ai, azure-openai
#   Best for main model handling: copilot (GitHub Copilot), openai (GPT-4o), anthropic (Claude)
AI_PROVIDER=copilot
AI_MODEL=

# GitHub Copilot (AI_PROVIDER=copilot or github-copilot)
GITHUB_TOKEN=

# OpenAI (STT_PROVIDER=openai, TTS_PROVIDER=openai)
# A single key covers Whisper STT, TTS, and DALL·E 3 image generation.
OPENAI_API_KEY=

# Azure OpenAI (AI_PROVIDER=azure-openai or STT_PROVIDER=azure-openai)
# Create an Azure OpenAI resource in the Azure portal, then deploy models under it.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_STT_DEPLOYMENT=whisper
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# STT (Speech-to-Text): transcribes voice input before sending to LLM.
#   Supported: openai (default), azure, azure-openai, google
#   Best for V2T: openai (Whisper) or azure-openai (Whisper via Azure)
STT_PROVIDER=openai
STT_MODEL=whisper-1
# Azure STT (STT_PROVIDER=azure)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_LANGUAGE=en-US
# Google STT (STT_PROVIDER=google)
GOOGLE_API_KEY=
GOOGLE_STT_LANGUAGE=en-US
GOOGLE_STT_ENCODING=WEBM_OPUS
GOOGLE_STT_SAMPLE_RATE=16000

# TTS (Text-to-Speech): synthesizes LLM response back to audio.
#   Supported: openai (default), azure, google, elevenlabs
#   Best for voice generation: openai (tts-1 / tts-1-hd) or elevenlabs (premium)
TTS_PROVIDER=openai
TTS_MODEL=tts-1
# TTS_VOICE: alloy (default) | ash | coral | echo | fable | onyx | nova | sage | shimmer
TTS_VOICE=alloy
# Azure TTS (TTS_PROVIDER=azure) — shares AZURE_SPEECH_KEY and AZURE_SPEECH_REGION above
AZURE_TTS_VOICE=en-US-JennyNeural
# Google TTS (TTS_PROVIDER=google) — shares GOOGLE_API_KEY above
GOOGLE_TTS_VOICE=en-US-Neural2-F
# ElevenLabs TTS (TTS_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_monolingual_v1

# ── External Service Integrations (all optional) ──────────────

# Plex Media Server
PLEX_URL=http://localhost:32400
PLEX_TOKEN=

# Overseerr / Jellyseerr
OVERSEERR_URL=http://localhost:5055
OVERSEERR_API_KEY=

# Tautulli (Plex monitoring)
TAUTULLI_URL=http://localhost:8181
TAUTULLI_API_KEY=

# Grafana
GRAFANA_URL=http://localhost:3000
GRAFANA_USER=
GRAFANA_PASSWORD=

# Portainer
PORTAINER_URL=http://localhost:9000
PORTAINER_API_KEY=

# Prometheus
PROMETHEUS_URL=http://localhost:9090

# Komga (comics/manga) — use API key OR user/password
KOMGA_URL=http://localhost:25600
KOMGA_API_KEY=
KOMGA_USER=
KOMGA_PASSWORD=

# Booklore (book library)
BOOKLORE_URL=http://localhost:8080
BOOKLORE_USER=
BOOKLORE_PASSWORD=

# Audiobookshelf
AUDIOBOOKSHELF_URL=http://localhost:13378
AUDIOBOOKSHELF_API_KEY=

# ROMm (ROM manager)
ROMM_URL=http://localhost:3000
ROMM_USER=
ROMM_PASSWORD=

# Immich (photo management)
IMMICH_URL=http://localhost:2283
IMMICH_API_KEY=

# UniFi Network Controller — use API key OR user/password
UNIFI_URL=https://localhost:8443
UNIFI_API_KEY=
UNIFI_USER=
UNIFI_PASSWORD=
UNIFI_SITE=default
UNIFI_IS_UDM=false

# Forgejo (Git hosting)
FORGEJO_URL=http://localhost:3000
FORGEJO_TOKEN=

# Pi-hole (DNS ad-blocking)
PIHOLE_URL=http://localhost:80
PIHOLE_PASSWORD=

# ── Calendar Integrations ─────────────────────────────────────────
# Home Assistant calendars are already available through HOMEASSISTANT_URL/TOKEN above.
# These env vars act as optional server-wide fallback sources.
# Per-user sources can also be created over the authenticated /calendar-sources API.
#
# iCloud Calendar (CalDAV)
ICLOUD_CALDAV_URL=https://caldav.icloud.com
ICLOUD_APPLE_ID=
ICLOUD_APP_SPECIFIC_PASSWORD=
#
# Microsoft 365 Calendar (Graph)
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_REFRESH_TOKEN=
M365_USER_ID=me
M365_REDIRECT_URI=http://localhost:8787/auth/m365/callback
M365_SCOPES=offline_access User.Read Calendars.Read Calendars.ReadWrite
#
# Optional subscribed ICS calendars. For one feed, use the simple vars below.
SUBSCRIBED_CALENDAR_NAME=Subscribed Calendar
SUBSCRIBED_CALENDAR_URL=
# For multiple feeds, use JSON instead:
# SUBSCRIBED_CALENDARS_JSON=[{"id":"school","name":"School Calendar","url":"https://example.com/calendar.ics"}]
SUBSCRIBED_CALENDARS_JSON=

# ── Apple Push Notification Service (APNs) ────────────────────
# Required for Live Activity push updates.
# Create a key at https://developer.apple.com → Certificates, Identifiers & Profiles → Keys → Add
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=org.davidjensenius.FluxHaus
APNS_KEY_PATH=./config/AuthKey.p8
APNS_ENVIRONMENT=production

# ── Kagi Web Search ───────────────────────────────────────────
# API key from https://kagi.com/settings?p=api
KAGI_API_KEY=

# ── Hindsight personal memory (optional) ──────────────────────
# Per-user personal memory shared with the user's other assistants. Disabled
# unless URL, app key, and allowed issuers are all set. The app key is
# server-side only and is never logged or returned to clients.
HINDSIGHT_URL=http://127.0.0.1:9088
HINDSIGHT_APP_KEY=
# Comma-separated OIDC issuer URLs whose users may use personal memory.
HINDSIGHT_ALLOWED_ISSUERS=
HINDSIGHT_BANK=shared
HINDSIGHT_TIMEOUT_MS=4000

# ── Rainbow.ai Weather Radar ──────────────────────────────────
# API key from https://developer.rainbow.ai
RAINBOW_API_KEY=
# Color palette: 0=Rainbow, 1=TWC, 2=Dark Sky, 3=Meteored, 4=Nexrad
# See https://doc.rainbow.ai/tile_colors/
RAINBOW_COLOR=1
